{
  "nom": "Évaluation Access - résultats et structure",
  "version": "2.0",
  "description": "Évaluation automatique d'une base Microsoft Access par comparaison avec une base solution.",

  "note": {
    "min": 0.0,
    "max": 20.0,
    "arrondi": 2,
    "mode": "points"
  },

  "tolerance": {
    "active": false,
    "valeur": 0
  },

  "erreur_fatale": false,

  "ponderation": {
    "base_de_donnees": 20.0
  },

  "axes_bd": {
    "tables": {
      "points": 4.0,
      "obligatoire": true,
      "methode": "comparaison"
    },

    "champs": {
      "points": 4.0,
      "obligatoire": true,
      "methode": "comparaison"
    },

    "types_champs": {
      "points": 2.0,
      "obligatoire": false,
      "methode": "comparaison"
    },

    "cles_primaires": {
      "points": 2.0,
      "obligatoire": true,
      "methode": "comparaison"
    },

    "relations": {
      "points": 4.0,
      "obligatoire": true,
      "methode": "comparaison"
    },

    "requetes": {
      "points": 4.0,
      "obligatoire": false,
      "methode": "comparaison"
    }
  },

  "donnees": {
    "active": true,
    "points": 2.0,
    "methode": "optionnelle",
    "comparer": {
      "nombre_enregistrements": true,
      "valeurs": true
    }
  },

  "comparaison": {

    "tables": {
      "ignorer_systeme": true,
      "sensible_casse": false,
      "ordre_indifferent": true
    },

    "champs": {
      "ordre_indifferent": true,
      "sensible_casse": false,
      "verifier_nom": true,
      "verifier_type": true,
      "verifier_taille": true,
      "verifier_obligatoire": true,
      "verifier_valeur_defaut": false
    },

    "cles": {
      "verifier_cle_primaire": true,
      "verifier_composition": true,
      "ordre_indifferent": false
    },

    "relations": {
      "verifier_table_source": true,
      "verifier_champ_source": true,
      "verifier_table_cible": true,
      "verifier_champ_cible": true,
      "verifier_integrite_referentielle": true,
      "ordre_indifferent": true
    },

    "requetes": {
      "verifier_nom": true,
      "verifier_sql": true,
      "normaliser_espaces": true,
      "ignorer_casse_sql": true,
      "ordre_indifferent": true
    }
  },

  "calcul": {

    "tables": {
      "points_par_element": true,
      "repartition": "proportionnelle"
    },

    "champs": {
      "repartition": "proportionnelle"
    },

    "types_champs": {
      "repartition": "proportionnelle"
    },

    "cles_primaires": {
      "repartition": "proportionnelle"
    },

    "relations": {
      "repartition": "proportionnelle"
    },

    "requetes": {
      "repartition": "proportionnelle"
    },

    "note_finale": "somme_axes"
  },

